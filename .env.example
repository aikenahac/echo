NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/library
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/library


# Database
DATABASE_URL=postgres://postgres:postgres@localhost:5432/echo

# Data Source API (for book search)
DATA_SOURCE_API_URL=http://localhost:3001
DATA_SOURCE_API_KEY=your-secure-api-key-here

# AWS Info
AWS_REGION=eu-central-2
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET_NAME=
AWS_S3_PUBLIC_URL= # endpoint

# Docker Postgres
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=echo

# Stripe (Payment Processing)
STRIPE_SECRET_KEY=sk_test_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Resend (Email Service)
RESEND_API_KEY=re_...
RESEND_FROM_EMAIL=noreply@yourdomain.com

# Application URLs
NEXT_PUBLIC_BASE_URL=http://localhost:3000
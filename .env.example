NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

NEXT_PUBLIC_CLERK_SIGN_IN_FORCE_REDIRECT_URL=
NEXT_PUBLIC_CLERK_SIGN_UP_FORCE_REDIRECT_URL=


# Database
DATABASE_URL=postgres://postgres:postgres@localhost:5432/echo

# Docker Postgres
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=echo

# Contact sent to Open Library in our User-Agent (they ask API users to identify themselves)
OPEN_LIBRARY_CONTACT=you@yourdomain.com

# Lemon Squeezy (Payments, merchant of record)
LEMON_SQUEEZY_API_KEY=...
LEMON_SQUEEZY_STORE_ID=...
LEMON_SQUEEZY_WEBHOOK_SECRET=...
# Create checkouts in test mode (use with a test-mode API key)
LEMON_SQUEEZY_TEST_MODE=true

# Resend (Email Service)
RESEND_API_KEY=re_...
RESEND_FROM_EMAIL=noreply@yourdomain.com

# Application URLs
NEXT_PUBLIC_BASE_URL=http://localhost:3000
# Support page: inbox for ticket copies (and Reply-To on acknowledgements)
SUPPORT_EMAIL=support@yourdomain.com
# Secret key for hashing client IPs on support tickets (any long random string)
SUPPORT_IP_SALT=esfsoifjsdofjsdofjsoidjosidfjosi

# RevenueCat server API key and exact webhook Authorization header value
REVENUECAT_SECRET_KEY=
REVENUECAT_WEBHOOK_AUTH=
